{
  "manifest_version": 3,
  "name": "GitHub Username Renamer",
  "version": "1.0.0",
  "description": "Show real names instead of GitHub usernames across github.com, with profile links left intact.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "GitHub Username Renamer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/common.js", "src/content.js", "src/hovercard.js"],
      "css": ["src/content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
